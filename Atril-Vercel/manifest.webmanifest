{
 "name": "Atril",
 "short_name": "Atril",
 "description": "Lector de PDF tipo libro digital, con audiolibro.",
 "lang": "es",
 "start_url": "./",
 "scope": "./",
 "display": "standalone",
 "orientation": "any",
 "background_color": "#efedf3",
 "theme_color": "#1d1730",
 "icons": [
  {
   "src": "icon-192.png",
   "sizes": "192x192",
   "type": "image/png"
  },
  {
   "src": "icon-512.png",
   "sizes": "512x512",
   "type": "image/png"
  },
  {
   "src": "icon-maskable-512.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "maskable"
  }
 ],
 "share_target": {
  "action": "./compartir",
  "method": "POST",
  "enctype": "multipart/form-data",
  "params": {
   "files": [
    {
     "name": "pdf",
     "accept": [
      "application/pdf",
      ".pdf"
     ]
    }
   ]
  }
 }
}